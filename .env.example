# ==========================================
# Time2Go Configuration
# ==========================================

# ------------------------------------------
# Application Configuration
# ------------------------------------------
APP_NAME=time2go
APP_ENV=development          # development, staging, production
APP_PORT=8080               # REST API port
GRPC_PORT=50051             # gRPC server port

# ------------------------------------------
# Redis Configuration
# ------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=             # Leave empty for no password
REDIS_DB=0                  # Redis database number (0-15)
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5

# Redis Connection Timeouts
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_TIMEOUT=4s
REDIS_IDLE_TIMEOUT=300s

# ------------------------------------------
# Event Listener Configuration
# ------------------------------------------
# How often to check for events that are due for execution
LISTENER_INTERVAL=1s

# Maximum number of events to process in one batch
LISTENER_BATCH_SIZE=100

# Number of worker goroutines for parallel event execution
LISTENER_WORKER_COUNT=10

# Lock timeout for preventing duplicate execution
LISTENER_LOCK_TIMEOUT=30s

# ------------------------------------------
# HTTP Client Configuration
# ------------------------------------------
# Default timeout for outgoing HTTP requests (can be overridden per event)
HTTP_CLIENT_TIMEOUT=30s

# Maximum number of idle connections
HTTP_CLIENT_MAX_IDLE_CONNS=100

# Maximum idle connections per host
HTTP_CLIENT_MAX_IDLE_CONNS_PER_HOST=10

# Idle connection timeout
HTTP_CLIENT_IDLE_CONN_TIMEOUT=90s

# ------------------------------------------
# Logging Configuration
# ------------------------------------------
# Log level: debug, info, warn, error, fatal
LOG_LEVEL=info

# Log format: json, text
LOG_FORMAT=json

# Enable log file output
LOG_TO_FILE=false
LOG_FILE_PATH=/var/log/time2go/app.log

# ------------------------------------------
# Elastic APM Configuration (Optional)
# ------------------------------------------
# Enable/disable Elastic APM
ELASTIC_APM_ACTIVE=false

# Elastic APM Server URL
ELASTIC_APM_SERVER_URL=http://localhost:8200

# Service name as it appears in APM
ELASTIC_APM_SERVICE_NAME=time2go

# Environment (development, staging, production)
ELASTIC_APM_ENVIRONMENT=development

# APM Secret token (if required)
ELASTIC_APM_SECRET_TOKEN=

# APM API Key (if using API key authentication)
ELASTIC_APM_API_KEY=

# Transaction sample rate (0.0 to 1.0)
# 1.0 = 100% of transactions are sampled
ELASTIC_APM_TRANSACTION_SAMPLE_RATE=1.0

# ------------------------------------------
# Prometheus Metrics Configuration
# ------------------------------------------
# Enable Prometheus metrics endpoint
PROMETHEUS_ENABLED=true

# Metrics endpoint path
PROMETHEUS_PATH=/metrics

# ------------------------------------------
# Server Configuration
# ------------------------------------------
# Graceful shutdown timeout
SHUTDOWN_TIMEOUT=5s

# Read timeout for HTTP server
SERVER_READ_TIMEOUT=10s

# Write timeout for HTTP server
SERVER_WRITE_TIMEOUT=10s

# Idle timeout for HTTP server
SERVER_IDLE_TIMEOUT=120s

# Maximum header size
SERVER_MAX_HEADER_BYTES=1048576

# ------------------------------------------
# CORS Configuration (REST API)
# ------------------------------------------
# Enable CORS
CORS_ENABLED=true

# Allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=*

# Allowed methods (comma-separated)
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS

# Allowed headers (comma-separated)
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# Allow credentials
CORS_ALLOW_CREDENTIALS=true

# Max age for preflight requests (seconds)
CORS_MAX_AGE=3600

# ------------------------------------------
# Rate Limiting (Optional)
# ------------------------------------------
# Enable rate limiting
RATE_LIMIT_ENABLED=false

# Requests per second per IP
RATE_LIMIT_RPS=10

# Burst size
RATE_LIMIT_BURST=20

# ------------------------------------------
# Security Configuration
# ------------------------------------------
# Enable API authentication
API_AUTH_ENABLED=false

# API Key for authentication (if enabled)
API_KEY=your-secret-api-key-here

# Enable TLS for gRPC
GRPC_TLS_ENABLED=false
GRPC_TLS_CERT_FILE=/path/to/cert.pem
GRPC_TLS_KEY_FILE=/path/to/key.pem

# Enable TLS for REST API
REST_TLS_ENABLED=false
REST_TLS_CERT_FILE=/path/to/cert.pem
REST_TLS_KEY_FILE=/path/to/key.pem

# ------------------------------------------
# Performance Tuning
# ------------------------------------------
# Maximum number of CPU cores to use (0 = use all)
GOMAXPROCS=0

# Enable pprof profiling endpoint
PPROF_ENABLED=false
PPROF_PORT=6060

# ------------------------------------------
# Event Retention
# ------------------------------------------
# How long to keep completed events in Redis (in seconds)
# 0 = keep forever, -1 = delete immediately after completion
EVENT_RETENTION_SECONDS=86400  # 24 hours

# How long to keep failed events in Redis (in seconds)
FAILED_EVENT_RETENTION_SECONDS=604800  # 7 days

# ------------------------------------------
# Retry Configuration Defaults
# ------------------------------------------
# Default retry type if not specified (1=Fixed, 2=Exponential)
DEFAULT_RETRY_TYPE=1

# Default retry count/base (in seconds for Fixed, multiplier for Exponential)
DEFAULT_RETRY_COUNT=5

# Default max attempts
DEFAULT_MAX_ATTEMPTS=3

# ------------------------------------------
# Development & Debug
# ------------------------------------------
# Enable debug mode
DEBUG=false

# Enable request/response logging
LOG_REQUESTS=false

# Enable SQL query logging (if using SQL in future)
LOG_QUERIES=false

# Pretty print JSON responses (not recommended for production)
PRETTY_JSON=false

# ------------------------------------------
# External Services (Optional)
# ------------------------------------------
# Webhook for alerting on failures
ALERT_WEBHOOK_URL=

# Slack webhook for notifications
SLACK_WEBHOOK_URL=

# Email SMTP configuration (for alerting)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=time2go@example.com

# ------------------------------------------
# Feature Flags
# ------------------------------------------
# Enable experimental features
ENABLE_EVENT_HISTORY=false
ENABLE_DASHBOARD=false
ENABLE_WEBHOOK_VERIFICATION=false

# ------------------------------------------
# Notes:
# ------------------------------------------
# - All timeout values accept Go duration format: 
#   Valid time units are "ns", "us", "ms", "s", "m", "h"
#   Examples: 300ms, 1.5s, 2m, 1h30m
#
# - Boolean values: true/false (case-insensitive)
#
# - For production, change APP_ENV to "production" and 
#   set appropriate security configurations
#
# - Always use strong, unique values for API_KEY in production
#
# - Consider enabling ELASTIC_APM_ACTIVE for better observability
